{
    "name": "store-system-backend",
    "version": "1.0.0",
    "description": "api for store system",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon",
        "infisical:pull": "infisical export --format=dotenv > .env",
        "build": "tsc",
        "start": "node dist/src/app.js",
        "prepare": "node ./scripts/install-husky.js",
        "db:generate": "pnpm exec prisma generate",
        "db:migrate": "pnpm exec prisma migrate dev --name auto",
        "db:studio": "pnpm exec prisma studio --port 5555 --browser none",
        "db:seed": "pnpm exec prisma db seed",
        "test:prepare": "DATABASE_URL=file:./test.db prisma db push --force-reset",
        "test:integration": "npm run test:prepare && vitest run test/integration",
        "test:unit": "vitest run src",
        "swagger": "ts-node ./swagger.ts"
    },
    "keywords": [
        "express",
        "nodejs"
    ],
    "license": "MIT",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "@prisma/adapter-better-sqlite3": "7.3.0",
        "@prisma/client": "7.3.0",
        "@types/multer": "^2.1.0",
        "@types/swagger-ui-express": "^4.1.8",
        "bcrypt": "^6.0.0",
        "bcryptjs": "3.0.3",
        "better-sqlite3": "12.6.2",
        "chalk": "^5.6.2",
        "cloudinary": "^2.9.0",
        "cookie-parser": "^1.4.7",
        "cors": "2.8.6",
        "dotenv": "17.2.4",
        "express": "5.2.1",
        "express-rate-limit": "^8.3.1",
        "express-validator": "7.3.1",
        "jsonwebtoken": "9.0.3",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.1",
        "prisma": "7.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/nodemailer": "^7.0.10",
        "@types/supertest": "^7.2.0",
        "husky": "^9.1.7",
        "js-yaml": "^4.1.1",
        "lint-staged": "^16.2.7",
        "nodemon": "3.1.11",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "swagger-autogen": "^2.23.7",
        "ts-node": "10.9.2",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "vitest": "^4.0.18"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx,json,css,scss,md}": "prettier --write"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
}
